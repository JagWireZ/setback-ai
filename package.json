{
  "name": "setback",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "npm --prefix ./backend run build",
    "test:frontend": "node --import tsx/esm --experimental-test-module-mocks --test test/**/*.test.js test/**/*.test.jsx",
    "test:frontend:coverage": "node --import tsx/esm --experimental-test-module-mocks --experimental-test-coverage --test test/**/*.test.js test/**/*.test.jsx",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "npm --prefix ./backend run typecheck",
    "test:backend": "npm --prefix ./backend test",
    "test:backend:coverage": "npm --prefix ./backend run test:coverage",
    "test:e2e": "npm run build:backend && playwright test",
    "deploy:staging": "tf -chdir=./infrastructure init && (tf -chdir=./infrastructure workspace select staging || tf -chdir=./infrastructure workspace new staging) && tf -chdir=./infrastructure apply -auto-approve -var=\"env=staging\"",
    "deploy:prod": "tf -chdir=./infrastructure init && (tf -chdir=./infrastructure workspace select prod || tf -chdir=./infrastructure workspace new prod) && tf -chdir=./infrastructure apply -auto-approve -var=\"env=prod\""
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudfront": "^3.1005.0",
    "@aws-sdk/client-cognito-identity": "^3.1005.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/credential-provider-cognito-identity": "^3.972.11",
    "@aws-sdk/protocol-http": "^3.370.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "global-jsdom": "^30.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.2.0",
    "ws": "^8.21.3"
  }
}
